{
  "name": "vscode-ollama",
  "displayName": "VSCode Ollama",
  "description": "VSCode Ollama is a powerful Visual Studio Code extension that seamlessly integrates Ollama's local LLM capabilities into your development environment.",
  "version": "1.3.0",
  "publisher": "warm3snow",
  "author": {
    "name": "warm3snow"
  },
  "license": "MIT",
  "icon": "resources/logo.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ollama",
    "llm",
    "ai",
    "chat",
    "local"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-ollama.openChat",
        "title": "Ollama: Open Chat"
      },
      {
        "command": "vscode-ollama.settings",
        "title": "Ollama: Settings"
      }
    ],
    "configuration": {
      "title": "VSCode Ollama",
      "properties": {
        "vscode-ollama.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama server base URL"
        },
        "vscode-ollama.model": {
          "type": "string",
          "default": "deepseek-r1:32b",
          "description": "Default model to use"
        },
        "vscode-ollama.maxTokens": {
          "type": "number",
          "default": 4096,
          "description": "Maximum tokens for response"
        },
        "vscode-ollama.keepAlive": {
          "type": "string",
          "default": "5 minutes",
          "description": "Keep-alive duration"
        },
        "vscode-ollama.systemPrompt": {
          "type": "string",
          "default": "Given the following conversation, relevant context, and a follow up question, reply with an answer to the current question the user is asking. Return only your response to the question given the above information following the users instructions as needed.",
          "description": "The system prompt to use for chat conversations"
        },
        "vscode-ollama.agent.tools": {
          "type": "string",
          "default": "read,bash,edit,write,grep,find,ls",
          "markdownDescription": "Agent 模式下允许模型使用的工具（逗号分隔）。可用工具： `read`、`bash`、`edit`、`write`、`grep`、`find`、`ls`。"
        },
        "vscode-ollama.agent.requireConfirmation": {
          "type": "boolean",
          "default": true,
          "description": "Agent 模式执行高风险工具前是否先在聊天窗口请求确认"
        },
        "vscode-ollama.agent.confirmTools": {
          "type": "string",
          "default": "bash,write,edit",
          "description": "Agent 模式下需要用户确认的工具（逗号分隔）"
        },
        "vscode-ollama.agent.appendSystemPrompt": {
          "type": "string",
          "default": "需要获取实时或外部信息（新闻、天气、最新版本、API 文档、错误信息等）时，请使用 bash 工具执行 curl 命令联网获取（例如 `curl -s 'https://...'`），不要声称无法联网或无法获取实时信息。",
          "markdownDescription": "追加到 Agent 系统提示末尾的自定义指令，例如默认使用中文回复或遵循团队的编码规范。"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/warm3snow/vscode-ollama"
  },
  "bugs": {
    "url": "https://github.com/warm3snow/vscode-ollama/issues"
  },
  "homepage": "https://github.com/warm3snow/vscode-ollama#readme",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js --production && node scripts/verify-webview.js",
    "verify:webview": "node scripts/verify-webview.js",
    "watch": "node esbuild.js --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/node": "^16.x.x",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^5.x.x",
    "@typescript-eslint/parser": "^5.x.x",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.21.0",
    "eslint": "^8.x.x",
    "marked": "^9.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "typebox": "1.3.7"
  }
}
